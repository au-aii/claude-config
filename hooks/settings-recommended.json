{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/secrets/**)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(**/.config/gcloud/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__CLAUDE_CONFIG_DIR__/hooks/guard.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__CLAUDE_CONFIG_DIR__/hooks/guard-edit.sh\""
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__CLAUDE_CONFIG_DIR__/hooks/guard-configchange.sh\""
          }
        ]
      }
    ]
  }
}
